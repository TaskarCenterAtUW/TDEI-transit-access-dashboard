# Copy this file to ".env" and fill in your values. The real .env is gitignored.

# ── Azure Blob Storage ────────────────────────────────────────────────────
# Connection string for the storage account that holds the large data files.
# Needed to UPLOAD data (upload_to_azure.py). Get it from the Azure portal:
#   Storage account → Security + networking → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"

# Container name inside the storage account (publicly readable).
AZURE_CONTAINER_NAME="walksheds"

# Optional: for anonymous DOWNLOAD only (download_from_azure.py) without a key,
# since the container is public. Use instead of the connection string.
# AZURE_ACCOUNT_URL="https://<account>.blob.core.windows.net"

# ── TDEI Walkshed API (pipeline only) ─────────────────────────────────────
# Required to GENERATE walkshed data (run_city_pipeline.py / batch_all_cities.py).
# Not needed just to view the dashboard.
# TDEI_USERNAME="your_tdei_username"
# TDEI_PASSWORD="your_tdei_password"
